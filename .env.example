# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# `.env` is gitignored — never commit real credentials.
# Real environment variables take precedence over this file, so you can also
# override any of these inline:  AZURE_OPENAI_API_KEY=... python script.py

# --- Azure OpenAI (GPT-4o-mini judge, used by the EAS scorers) -------------
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Hugging Face (only needed for gated model downloads) ------------------
HF_TOKEN=
